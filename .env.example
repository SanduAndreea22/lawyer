# Copy to .env and fill in for local development or deployment.
# .env is gitignored - never commit real secrets.

# Generate one with: python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
DJANGO_SECRET_KEY=change-me

# Set to False in any real deployment.
DJANGO_DEBUG=True

# Comma-separated. Required when DJANGO_DEBUG=False.
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
DJANGO_CSRF_TRUSTED_ORIGINS=https://your-domain.example

# Only relevant when DJANGO_DEBUG=False. Leave on unless the deployment
# already terminates TLS in a way Django can't see (rare).
DJANGO_SECURE_SSL_REDIRECT=True
